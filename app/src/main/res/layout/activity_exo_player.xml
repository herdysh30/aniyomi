<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/exo_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:controller_layout_id="@layout/exo_empty_controller"
        app:show_buffering="when_playing" />

    <ProgressBar
        android:id="@+id/exo_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Gesture feedback (volume / brightness / seek) -->
    <TextView
        android:id="@+id/exo_gesture_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:background="#66000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="100%" />

    <!-- Top bar: back, title, subtitle/audio/more -->
    <LinearLayout
        android:id="@+id/exo_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/exo_gradient_top"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/exo_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_24dp"
            app:tint="@android:color/white"
            android:contentDescription="@null"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/exo_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                tools:text="Anime Title" />

            <TextView
                android:id="@+id/exo_episode_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textColor="#B3FFFFFF"
                tools:text="Episode 1" />
        </LinearLayout>

        <ImageView
            android:id="@+id/exo_btn_hd"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_exo_hd"
            app:tint="@android:color/white"
            android:contentDescription="@null"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/exo_btn_sub"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_exo_subtitle"
            app:tint="@android:color/white"
            android:contentDescription="@null"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/exo_btn_audio"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_exo_audio"
            app:tint="@android:color/white"
            android:contentDescription="@null"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/exo_btn_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_exo_more"
            app:tint="@android:color/white"
            android:contentDescription="@null"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

    <!-- Bottom bar -->
    <LinearLayout
        android:id="@+id/exo_own_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/exo_gradient_bottom"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/exo_own_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_pause_24dp"
                app:tint="@android:color/white"
                android:contentDescription="@null"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/exo_own_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                tools:text="00:00" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@+id/exo_timebar"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                app:bar_height="3dp"
                app:scrubber_color="#FF1E88E5"
                app:played_color="#FF1E88E5"
                app:unplayed_color="#66FFFFFF"
                app:buffered_color="#66FFFFFF"
                app:ad_marker_color="#FFFFD54F" />

            <TextView
                android:id="@+id/exo_own_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                tools:text="00:00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/exo_btn_autonext"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_skip_next_24dp"
                app:tint="@android:color/white"
                android:contentDescription="@null"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:alpha="0.5" />

            <ImageView
                android:id="@+id/exo_btn_lock"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_exo_lock"
                app:tint="@android:color/white"
                android:contentDescription="@null"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/exo_btn_rotate"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_exo_rotate"
                app:tint="@android:color/white"
                android:contentDescription="@null"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/exo_btn_speed"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="1x" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/exo_btn_aspect"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_exo_aspect"
                app:tint="@android:color/white"
                android:contentDescription="@null"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/exo_btn_pip"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_exo_pip"
                app:tint="@android:color/white"
                android:contentDescription="@null"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center cluster: prev | rewind | play/pause | forward | next -->
    <LinearLayout
        android:id="@+id/exo_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/exo_btn_prev_episode"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="8dp"
            android:src="@drawable/ic_skip_previous_24dp"
            app:tint="@android:color/white"
            android:contentDescription="@null"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/exo_btn_rewind"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="12dp"
            android:src="@drawable/ic_replay_10_24dp"
            app:tint="@android:color/white"
            android:contentDescription="@null"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/exo_center_play_pause"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:padding="18dp"
            android:src="@drawable/ic_pause_24dp"
            app:tint="@android:color/white"
            android:contentDescription="@null"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/exo_btn_forward"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="12dp"
            android:src="@drawable/ic_forward_10_24dp"
            app:tint="@android:color/white"
            android:contentDescription="@null"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/exo_btn_next_episode"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="8dp"
            android:src="@drawable/ic_skip_next_24dp"
            app:tint="@android:color/white"
            android:contentDescription="@null"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Skip intro button (always visible with controls, jumps +introLen) -->
    <TextView
        android:id="@+id/exo_btn_skip_intro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="#B3000000"
        android:visibility="gone"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/exo_own_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="+85s" />

    <!-- Unlock flash button (visible while locked) -->
    <ImageView
        android:id="@+id/exo_btn_unlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:src="@drawable/ic_exo_eye"
        app:tint="@android:color/white"
        android:contentDescription="@null"
        android:background="#66000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

